#!/bin/bash -p
# Root-only 60-second collector recovery helper; invoked only by the dispatcher.
set -Eeuo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
unset BASH_ENV CDPATH ENV

readonly SERVICE=secmon-collector.service
readonly DATABASE=/var/lib/secmon/secmon.db
readonly SERVICE_USER=secmon
readonly MIGRATE_HELPER=/usr/local/libexec/secmon/migrate-db
readonly APPROVAL_MANIFEST=/usr/local/libexec/secmon/runtime-approved.manifest
readonly DEPLOYED_ROOT=/opt/secmon
readonly UNIT_FILE=/etc/systemd/system/secmon-collector.service
readonly APPROVED_RUNTIME_HEAD=21eb7787ce4e8d8cd16ed47e7533aa21d424f643
readonly EXPECTED_RESTART=on-failure
readonly EXPECTED_RESTART_USEC=5000000
readonly RUNTIME_SOURCE_FILES=(
  backend/__init__.py
  backend/collectors/__init__.py
  backend/collectors/main.py
  backend/collectors/ssh_collector.py
  backend/config.py
  backend/database.py
  backend/models/__init__.py
  backend/notifiers/__init__.py
  backend/notifiers/telegram.py
  backend/parsers/__init__.py
  backend/parsers/ssh_parser.py
  backend/services/__init__.py
  backend/services/log_sources.py
  database/__init__.py
)
readonly RUNNER_PATH=database/migrate.py
readonly APPROVED_MIGRATIONS=(
  001_initial.sql
  005_ssh_parser.sql
  006_log_sources_defaults.sql
  007_add_log_source_stats.sql
)

abort() {
  /usr/bin/logger -p authpriv.err -t secmon-maintenance -- "action=runtime-recovery result=$1"
  printf 'ABORT_%s\n' "$1" >&2
  exit 1
}

require_root() { [[ $(/usr/bin/id -u) -eq 0 ]] || abort ROOT_REQUIRED; }

show_property() {
  /usr/bin/systemctl show --value -p "$1" "$SERVICE" --no-pager
}

require_service_inactive() {
  [[ $(show_property ActiveState) == inactive ]] || abort SERVICE_NOT_INACTIVE
}

normalize_duration_usec() {
  # RestartUSec is systemd's formal property.  Normalize its permitted
  # display forms to microseconds so equivalent values compare identically.
  local remaining=$1 amount unit rest factor total=0

  remaining=${remaining,,}
  remaining=${remaining#"${remaining%%[![:space:]]*}"}
  remaining=${remaining%"${remaining##*[![:space:]]}"}
  [[ -n "$remaining" ]] || return 1

  if [[ "$remaining" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$remaining"
    return 0
  fi

  while [[ -n "$remaining" ]]; do
    if [[ ! "$remaining" =~ ^([0-9]+)[[:space:]]*(us|ms|s|min|h|d|w)([[:space:]]+(.*))?$ ]]; then
      return 1
    fi
    amount=${BASH_REMATCH[1]}
    unit=${BASH_REMATCH[2]}
    rest=${BASH_REMATCH[4]:-}
    case "$unit" in
      us) factor=1 ;;
      ms) factor=1000 ;;
      s) factor=1000000 ;;
      min) factor=60000000 ;;
      h) factor=3600000000 ;;
      d) factor=86400000000 ;;
      w) factor=604800000000 ;;
      *) return 1 ;;
    esac
    total=$((total + 10#$amount * factor))
    remaining=$rest
  done
  printf '%s\n' "$total"
}

manifest_metadata_is_secure() {
  [[ "$1" =~ ^0:0:0?[0-6][0-4][0-4]$ ]]
}

load_approval_manifest() {
  local kind name digest extra mode
  declare -g manifest_head=''
  declare -gA approved_runtime_sha=() approved_migration_sha=()
  declare -g approved_runner_sha='' approved_unit_sha=''
  [[ -f "$APPROVAL_MANIFEST" && ! -L "$APPROVAL_MANIFEST" ]] || return 1
  mode=$(/usr/bin/stat -c '%u:%g:%a' -- "$APPROVAL_MANIFEST") || return 1
  manifest_metadata_is_secure "$mode" || return 1
  while IFS='|' read -r kind name digest extra || [[ -n "$kind" ]]; do
    [[ -z "$kind" || "$kind" == \#* ]] && continue
    if [[ "$kind" == APPROVED_RUNTIME_HEAD=* ]]; then
      [[ -z "$name" && -z "$digest" && -z "$manifest_head" ]] || return 1
      manifest_head=${kind#APPROVED_RUNTIME_HEAD=}
      [[ "$manifest_head" =~ ^[0-9a-f]{40}$ ]] || return 1
      continue
    fi
    [[ -z "$extra" ]] || return 1
    case "$kind" in
      RUNTIME) [[ "$name" =~ ^[A-Za-z0-9_./-]+$ && "$digest" =~ ^[0-9a-f]{64}$ && -z ${approved_runtime_sha[$name]:-} ]] || return 1; approved_runtime_sha["$name"]=$digest ;;
      RUNNER) [[ "$name" == database/migrate.py && "$digest" =~ ^[0-9a-f]{64}$ && -z "$approved_runner_sha" ]] || return 1; approved_runner_sha=$digest ;;
      MIGRATION) [[ "$name" =~ ^[0-9]{3}_[A-Za-z0-9_.-]+[.]sql$ && "$digest" =~ ^[0-9a-f]{64}$ && -z ${approved_migration_sha[$name]:-} ]] || return 1; approved_migration_sha["$name"]=$digest ;;
      UNIT) [[ "$name" == systemd/secmon-collector.service && "$digest" =~ ^[0-9a-f]{64}$ && -z "$approved_unit_sha" ]] || return 1; approved_unit_sha=$digest ;;
      *) return 1 ;;
    esac
  done <"$APPROVAL_MANIFEST"
  [[ -n "$manifest_head" && -n "$approved_runner_sha" && -n "$approved_unit_sha" && \
    ${#approved_runtime_sha[@]} -eq ${#RUNTIME_SOURCE_FILES[@]} && \
    ${#approved_migration_sha[@]} -eq ${#APPROVED_MIGRATIONS[@]} ]]
}

verify_runtime_file_hashes() {
  local relative_path deployed_path expected_hash actual_hash
  for relative_path in "${RUNTIME_SOURCE_FILES[@]}"; do
    deployed_path="$DEPLOYED_ROOT/$relative_path"
    expected_hash=${approved_runtime_sha[$relative_path]:-}
    [[ -n "$expected_hash" && -f "$deployed_path" && ! -L "$deployed_path" ]] || return 1
    actual_hash=$(/usr/bin/sha256sum -- "$deployed_path" | /usr/bin/cut -d ' ' -f 1) || return 1
    [[ "$expected_hash" == "$actual_hash" ]] || return 1
  done
  deployed_path="$DEPLOYED_ROOT/$RUNNER_PATH"
  [[ -f "$deployed_path" && ! -L "$deployed_path" ]] || return 1
  actual_hash=$(/usr/bin/sha256sum -- "$deployed_path" | /usr/bin/cut -d ' ' -f 1) || return 1
  [[ "$approved_runner_sha" == "$actual_hash" ]] || return 1
}

verify_migration_hashes() {
  local migration deployed_path expected_hash actual_hash
  for migration in "${APPROVED_MIGRATIONS[@]}"; do
    deployed_path="$DEPLOYED_ROOT/database/migrations/$migration"
    expected_hash=${approved_migration_sha[$migration]:-}
    [[ -n "$expected_hash" && -f "$deployed_path" && ! -L "$deployed_path" ]] || return 1
    actual_hash=$(/usr/bin/sha256sum -- "$deployed_path" | /usr/bin/cut -d ' ' -f 1) || return 1
    [[ "$expected_hash" == "$actual_hash" ]] || return 1
  done
}

verify_systemd_unit_hash() {
  local actual_hash
  [[ -f "$UNIT_FILE" && ! -L "$UNIT_FILE" ]] || return 1
  actual_hash=$(/usr/bin/sha256sum -- "$UNIT_FILE" | /usr/bin/cut -d ' ' -f 1) || return 1
  [[ "$approved_unit_sha" == "$actual_hash" ]] || return 1
}

verify_approved_deployed_hashes() {
  load_approval_manifest || abort MANIFEST_METADATA_INVALID
  printf 'MANIFEST_METADATA_GATE=PASS\n'
  [[ "$manifest_head" == "$APPROVED_RUNTIME_HEAD" ]] || abort APPROVED_HEAD_MISMATCH
  printf 'APPROVED_RUNTIME_HEAD=%s\n' "$manifest_head"
  printf 'APPROVED_HEAD_GATE=PASS\n'
  verify_runtime_file_hashes || abort RUNTIME_FILE_HASH_MISMATCH
  printf 'RUNTIME_FILE_HASH_GATE=PASS\n'
  verify_systemd_unit_hash || abort SYSTEMD_UNIT_HASH_MISMATCH
  printf 'SYSTEMD_UNIT_HASH_GATE=PASS\n'
  verify_migration_hashes || abort MIGRATION_HASH_MISMATCH
  printf 'MIGRATION_HASH_GATE=PASS\n'
  printf 'DEPLOYED_APPROVED_RUNTIME_HASH=PASS\n'
  printf 'EFFECTIVE_UNIT_APPROVED_HASH=PASS\n'
}

verify_restart_policy() {
  local effective_restart effective_usec_raw effective_usec_normalized

  effective_restart=$(show_property Restart) || return 1
  effective_usec_raw=$(show_property RestartUSec) || return 1
  printf 'EFFECTIVE_RESTART=%s\n' "$effective_restart"
  printf 'EFFECTIVE_RESTART_USEC_RAW=%s\n' "$effective_usec_raw"
  if ! effective_usec_normalized=$(normalize_duration_usec "$effective_usec_raw"); then
    printf 'EFFECTIVE_RESTART_USEC_NORMALIZED=UNPARSEABLE\n'
    return 1
  fi
  printf 'EFFECTIVE_RESTART_USEC_NORMALIZED=%s\n' "$effective_usec_normalized"
  [[ "$effective_restart" == "$EXPECTED_RESTART" && \
    "$effective_usec_normalized" == "$EXPECTED_RESTART_USEC" ]]
}

journal_summary() {
  /usr/bin/journalctl -u "$SERVICE" --since "$1" --no-pager --output=cat 2>/dev/null |
    /usr/bin/awk '
      BEGIN { sqlite = table = permission = traceback = 0 }
      { line = tolower($0)
        if (line ~ /sqlite3[.]operationalerror/) sqlite++
        if (line ~ /no such table/) table++
        if (line ~ /permission denied/) permission++
        if (line ~ /traceback[(]most recent call last[)]/) traceback++
      }
      END { printf "%d %d %d %d\n", sqlite, table, permission, traceback }'
}

main() {
  local started_at pre_restarts first_pid sample_restarts sample_pid active substate
  local sample sqlite_errors table_errors permission_errors tracebacks
  [[ $# -eq 0 ]] || abort UNEXPECTED_ARGUMENTS
  require_root
  verify_approved_deployed_hashes
  require_service_inactive
  [[ -f "$DATABASE" ]] || abort DATABASE_MISSING
  "$MIGRATE_HELPER" || abort MIGRATION_PRECONDITION_FAILED

  /usr/bin/systemctl daemon-reload || abort DAEMON_RELOAD_FAILED
  verify_restart_policy || abort RESTART_POLICY_MISMATCH
  pre_restarts=$(show_property NRestarts) || abort NRESTARTS_UNAVAILABLE
  [[ "$pre_restarts" =~ ^[0-9]+$ ]] || abort NRESTARTS_INVALID
  started_at=$(/usr/bin/date -u --iso-8601=seconds)
  /usr/bin/systemctl reset-failed "$SERVICE" || abort RESET_FAILED_FAILED
  /usr/bin/systemctl start "$SERVICE" || abort START_FAILED
  first_pid=$(show_property MainPID) || abort MAINPID_UNAVAILABLE
  [[ "$first_pid" =~ ^[1-9][0-9]*$ ]] || abort MAINPID_INVALID

  for sample in 1 2 3 4 5 6; do
    /usr/bin/sleep 10
    active=$(show_property ActiveState) || abort SERVICE_STATE_UNAVAILABLE
    substate=$(show_property SubState) || abort SERVICE_STATE_UNAVAILABLE
    sample_pid=$(show_property MainPID) || abort MAINPID_UNAVAILABLE
    sample_restarts=$(show_property NRestarts) || abort NRESTARTS_UNAVAILABLE
    [[ "$active" == active && "$substate" == running ]] || abort SERVICE_NOT_RUNNING
    [[ "$sample_pid" == "$first_pid" ]] || abort MAINPID_CHANGED
    [[ "$sample_restarts" == "$pre_restarts" ]] || abort NRESTARTS_INCREASED
  done

  read -r sqlite_errors table_errors permission_errors tracebacks < <(journal_summary "$started_at")
  [[ "$sqlite_errors" == 0 && "$table_errors" == 0 && "$permission_errors" == 0 && "$tracebacks" == 0 ]] \
    || abort JOURNAL_ERROR_SIGNATURE_FOUND
  /usr/bin/runuser -u "$SERVICE_USER" -- /usr/bin/sqlite3 -batch "$DATABASE" \
    'BEGIN IMMEDIATE; PRAGMA schema_version; ROLLBACK;' >/dev/null \
    || abort RUNTIME_SQLITE_CAPABILITY_FAILED

  /usr/bin/logger -p authpriv.notice -t secmon-maintenance -- 'action=runtime-recovery result=stable'
  printf 'JOURNAL_SQLITE3_OPERATIONALERROR_COUNT=0\n'
  printf 'JOURNAL_NO_SUCH_TABLE_COUNT=0\n'
  printf 'JOURNAL_PERMISSION_DENIED_COUNT=0\n'
  printf 'JOURNAL_TRACEBACK_COUNT=0\n'
  printf 'RUNTIME_RESULT=SYSTEMD_RUNTIME_STABLE\n'
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
